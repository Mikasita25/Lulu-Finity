# Acepta JSON, comas o saltos de línea. Todas deben pertenecer a tu cuenta/proyecto.
EULER_API_KEYS=["key-paga-1","key-paga-2","key-paga-3"]

# Opcional. Si está vacío, el relay acepta clientes sin token.
# También acepta JSON, comas o saltos de línea.
CLIENT_TOKENS=["cambia-este-token-largo"]

UPSTREAM_WS_URL=wss://ws.eulerstream.com
KEY_COOLDOWN_MS=1800000
QUOTA_COOLDOWN_MS=86400000
MAX_CONNECTIONS_PER_KEY=1
MAX_CLIENTS=50
MAX_CONNECTION_ATTEMPTS_PER_MINUTE=30
UPSTREAM_OPEN_TIMEOUT_MS=18000
PORT=3000
