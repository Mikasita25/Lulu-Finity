# Acepta JSON, comas o saltos de línea. Todas deben pertenecer a tu cuenta/proyecto.
EULER_API_KEYS=["key-paga-1","key-paga-2","key-paga-3"]

# OBLIGATORIO. Usa uno o varios secretos aleatorios de al menos 32 bytes.
# No reutilices API keys de EulerStream ni tokens de GitHub.
# Rota estos tokens si una build antigua los llegó a incluir dentro del cliente.
CLIENT_TOKENS=["reemplaza-por-un-token-aleatorio-de-32-bytes-o-mas"]

UPSTREAM_WS_URL=wss://ws.eulerstream.com
KEY_COOLDOWN_MS=1800000
QUOTA_COOLDOWN_MS=86400000
MAX_CONNECTIONS_PER_KEY=1
MAX_CLIENTS=50
MAX_CONNECTION_ATTEMPTS_PER_MINUTE=20
UPSTREAM_OPEN_TIMEOUT_MS=18000

# Medidor diario mostrado en Ajustes de Lulu Finity.
DAILY_USAGE_LIMIT=7500
USAGE_PER_CONNECTION=2
USER_DAILY_CONNECTION_LIMIT=600
# Opcional: ruta persistente. Con un Railway Volume puedes usar /data/lulu-usage.json
USAGE_STATE_FILE=.lulu-usage.json

# Recomendado para el canal privado de actualizaciones.
# El token vive SOLO en Railway y debe tener acceso de solo lectura al repositorio privado.
GITHUB_RELEASE_REPO=Mikasita25/Lulu-Finity
GITHUB_RELEASE_TOKEN=
UPDATE_REQUIRE_AUTH=true

PORT=3000
