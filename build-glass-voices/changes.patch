diff --git a/src/glass.css b/src/glass.css
new file mode 100644
index 0000000..21b3127
--- /dev/null
+++ b/src/glass.css
@@ -0,0 +1,60 @@
+/* Lulu Glass: shared surfaces and controls, layered after existing themes. */
+:root {
+  --glass-surface: color-mix(in srgb, var(--bg2) 58%, transparent);
+  --glass-raised: color-mix(in srgb, var(--bg2) 73%, transparent);
+  --glass-edge: rgba(255,255,255,.19);
+  --glass-shadow: 0 18px 48px rgba(4,3,14,.24), inset 0 1px 0 rgba(255,255,255,.12);
+  color-scheme: dark;
+}
+html, body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif; }
+.app-shell {
+  background: radial-gradient(ellipse at 83% 3%, var(--glow-pink, rgba(255,117,172,.25)), transparent 44%),
+    radial-gradient(ellipse at 30% 82%, var(--glow-purple, rgba(154,87,196,.22)), transparent 50%),
+    linear-gradient(135deg, var(--bg), var(--bg2) 55%, var(--bg)) !important;
+}
+.titlebar, .sidebar {
+  background: color-mix(in srgb, var(--bg) 65%, transparent) !important;
+  backdrop-filter: blur(26px) saturate(145%); -webkit-backdrop-filter: blur(26px) saturate(145%);
+  border-color: var(--glass-edge) !important;
+}
+.titlebar { box-shadow: 0 1px 0 rgba(255,255,255,.04); }
+.sidebar { gap: 12px !important; }
+.logo-mark { border-radius: 15px !important; box-shadow: inset 0 1px 0 #fff8, 0 8px 22px #0003 !important; }
+.nav-item { border-radius: 13px !important; transition: background .2s ease, border-color .2s ease, transform .2s ease !important; }
+.nav-item:hover { background: rgba(255,255,255,.09) !important; }
+.nav-item.active { background: color-mix(in srgb, var(--pink) 19%, transparent) !important; border-color: color-mix(in srgb,var(--pink) 34%,transparent) !important; box-shadow: inset 0 1px 0 #ffffff20 !important; }
+.main-content { padding: 30px 34px 42px !important; }
+.page { animation: glass-enter .28s ease both; }
+@keyframes glass-enter { from {opacity:0;transform:translateY(7px)} to {opacity:1;transform:translateY(0)} }
+.panel, .studio-card, .studio-hero, .stat-card, .sidebar-bottom, .account-chip,
+.widget-launch, .design-page-note, .status-banner, .feature-search-results,
+.dialog, dialog, .modal-content, .release-notice, .local-voice-card {
+  background: linear-gradient(145deg, rgba(255,255,255,.065), transparent 55%), var(--glass-surface) !important;
+  border: 1px solid var(--glass-edge) !important;
+  border-radius: 22px !important;
+  box-shadow: var(--glass-shadow) !important;
+  backdrop-filter: blur(24px) saturate(150%); -webkit-backdrop-filter: blur(24px) saturate(150%);
+}
+.studio-hero { background: radial-gradient(ellipse at 80% 0%,color-mix(in srgb,var(--pink) 18%,transparent),transparent 65%), var(--glass-surface) !important; }
+.panel-header, .studio-card-head { border-color: rgba(255,255,255,.09) !important; }
+.widget-focus-header { background: var(--glass-raised) !important; backdrop-filter: blur(24px); }
+dialog::backdrop { background: rgba(8,7,17,.65); backdrop-filter: blur(8px); }
+input:not([type=range]):not([type=checkbox]):not([type=radio]):not([type=color]), select, textarea {
+  background: rgba(10,9,22,.30) !important; color: var(--text) !important;
+  border: 1px solid rgba(255,255,255,.15) !important; border-radius: 13px !important;
+  box-shadow: inset 0 1px 2px rgba(0,0,0,.12);
+  transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
+}
+select option, select optgroup { background: var(--bg2); color: var(--text); }
+input::placeholder, textarea::placeholder { color: var(--muted); opacity:.75; }
+button { transition: transform .18s ease, background-color .18s ease, border-color .18s ease, box-shadow .18s ease, filter .18s ease !important; }
+button:not(:disabled):hover { filter: brightness(1.09); }
+button:not(:disabled):active { transform: scale(.975) !important; }
+button.primary, .primary { border-radius: 13px !important; background: linear-gradient(145deg, color-mix(in srgb,var(--pink) 78%,white),var(--pink)) !important; box-shadow: 0 7px 20px color-mix(in srgb,var(--pink) 24%,transparent), inset 0 1px 0 #ffffff99 !important; }
+.ghost, .secondary, .danger-outline, .icon-button { border-radius: 13px !important; border: 1px solid rgba(255,255,255,.16) !important; box-shadow: inset 0 1px 0 #ffffff14 !important; }
+.category-tabs, .tts-tabs { background: rgba(12,10,25,.32) !important; border: 1px solid rgba(255,255,255,.1); border-radius: 15px !important; }
+.category-tabs button, .tts-tabs button { border-radius: 11px !important; }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--pink) !important; outline-offset: 3px !important; }
+::-webkit-scrollbar { width: 8px; height: 8px; } ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.22); border-radius: 20px; }
+@media (max-width:1100px) { .main-content { padding: 22px !important; } }
+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; scroll-behavior: auto !important; } }
