{
  "expo": {
    "name": "Lulú Finity",
    "slug": "lulu-finity-mobile",
    "version": "1.2.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.mikasita.lulufinity.mobile",
      "versionCode": 15,
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      ["expo-notifications", { "color": "#FF5FC8" }],
      ["expo-audio", { "enableBackgroundPlayback": true }],
      "expo-document-picker",
      "expo-splash-screen"
    ],
    "extra": {
      "relayUrl": "wss://lulu-finity-production.up.railway.app/v1/tiktok/live"
    },
    "platforms": ["android"]
  }
}
