{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lulu Finity Rust Beta",
  "version": "1.4.0-beta.1",
  "identifier": "com.mikasita.lulufinity.rustbeta",
  "build": {
    "frontendDist": "../generated/frontend",
    "beforeBuildCommand": "npm run prepare:windows"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["desktop"],
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../generated/sidecar/": "backend/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
